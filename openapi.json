paths:
  /api/tables/{name}:
    get:
      parameters:
      - name: name
        in: path
        type: string
        required: true
        description: Name of the table
      responses:
        '200':
          description: Table rows
          schema:
            type: object
            properties:
              data:
                type: array
                items:
                  type: object
  /api/events:
    get:
      responses:
        '200':
          description: Event rows
          schema:
            type: object
            properties:
              data:
                type: array
                items:
                  type: object
  /api/events/need_packets:
    get:
      responses:
        '200':
          description: Event rows
          schema:
            type: object
            properties:
              data:
                type: array
                items:
                  type: object
  /api/events/for_review:
    get:
      responses:
        '200':
          description: Event rows
          schema:
            type: object
            properties:
              data:
                type: array
                items:
                  type: object
  /api/events/need_reupload: {}
  /api/events/status_summary:
    get:
      responses:
        '200':
          description: Event summary
          schema:
            type: object
            properties:
              data:
                type: object
                additionalProperties:
                  type: integer
  /api/events/by_status/{status}: {}
  /api/events/{int:event_id}: {}
  /api/users: {}
  /api/auth/me: {}
  /api/config:
    get:
      responses:
        '200':
          description: Resolved workflow configuration
          schema:
            type: object
            properties:
              data:
                type: object
                properties:
                  study_type:
                    type: string
                  workflow:
                    type: object
                    properties:
                      scrubbing:
                        type: boolean
                      screening:
                        type: boolean
                      sending:
                        type: boolean
                      reviewer_count:
                        type: integer
  /api/auth/dev_login: {}
  /api/auth/dev_logout: {}
  /api/auth/dev_set_roles: {}
  /api/auth/dev_seed_users: {}
  /api/reviewer/awaiting: {}
  /api/events/export: {}
  /api/events/download/{int:event_id}: {}
  /api/criteria: {}
  /api/solicitations: {}
  /api/events/{int:event_id}/screen: {}
  /api/events/bulk: {}
  /api/events/{int:event_id}/upload_scrubbed: {}
  /api/events/{int:event_id}/upload_raw: {}
  /api/events/assign_many: {}
  /api/events/send_many: {}
  /api/events/{int:event_id}/review:
    post:
      parameters:
      - name: event_id
        in: path
        type: integer
        required: true
        description: ID of the event being reviewed
      responses:
        '200':
          description: Review recorded; event lifecycle advanced
          schema:
            type: object
            properties:
              data:
                type: object
                properties:
                  event_id:
                    type: integer
                  status:
                    type: string
        '400':
          description: Invalid review body
        '403':
          description: Submitter is not an assigned reviewer for this event
        '404':
          description: Event not found
  /files/{path:filename}: {}
  /: {}
info:
  title: CNICS Validation API
  version: 1.0.0
openapi: 3.0.3
