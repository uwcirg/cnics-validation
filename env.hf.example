# Heart Failure Study Environment Configuration
# This file is commented out until Heart Failure study migration is needed
# Uncomment and modify as needed for Heart Failure study deployment

# Study identification
# STUDY_TYPE=hf
# STUDY_NAME="Heart Failure Validation"
# STUDY_ABBREVIATION="HF"

# Database configuration
# DB_NAME=cnics_hf_validation
# DB_USER=cnics_hf_user
# DB_PASSWORD=your_hf_password_here

# Domain and CORS configuration
# FRONTEND_ORIGIN=https://hf-validation.cirg.uw.edu
# SERVER_NAME=hf-validation.cirg.uw.edu

# Study-specific features
# ENABLE_PRE_SCRUB=false
# ENABLE_EF_MEASUREMENT=true
# ENABLE_HF_SPECIFIC_FIELDS=true

# Email configuration
# EMAIL_SUBJECT_PREFIX=CNICS / Heart Failure Validation
# EMAIL_FROM=hf-validation@cirg.washington.edu
# EMAIL_REPLY_TO=hf-validation@cirg.washington.edu

# FHIR server
# FHIR_SERVER=http://your-fhir-server.com

# File directories
# FILES_DIR=/app/webroot/files
# DOWNLOADS_DIR=/app/webroot/files/downloads

# External database (if needed)
# EXTERNAL_DB_URL=

# SMTP configuration
# SMTP_HOST=smtp.washington.edu
# SMTP_PORT=587
# SMTP_TLS=1
# SMTP_SSL=0
# SMTP_USER=hf-validation@cirg.washington.edu
# SMTP_PASSWORD=your_smtp_password_here
# EMAIL_ATTACH_PACKET=0
# EMAIL_TEST_MODE=0
