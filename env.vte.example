# VTE (Venothromboembolic) Study Environment Configuration
# This file is commented out until VTE study migration is needed
# Uncomment and modify as needed for VTE study deployment

# Study identification
# STUDY_TYPE=vte
# STUDY_NAME="VTE Validation"
# STUDY_ABBREVIATION="VTE"

# Database configuration
# DB_NAME=cnics_vte_validation
# DB_USER=cnics_vte_user
# DB_PASSWORD=your_vte_password_here

# Domain and CORS configuration
# FRONTEND_ORIGIN=https://vte-validation.cirg.uw.edu
# SERVER_NAME=vte-validation.cirg.uw.edu

# Study-specific features
# ENABLE_PRE_SCRUB=true  # VTE has prescrub step
# ENABLE_PRESCRUB_REJECTION=true  # VTE has PSREJECTED state
# ENABLE_VTE_SPECIFIC_FIELDS=true

# Email configuration
# EMAIL_SUBJECT_PREFIX=CNICS / VTE Validation
# EMAIL_FROM=vte-validation@cirg.washington.edu
# EMAIL_REPLY_TO=vte-validation@cirg.washington.edu

# FHIR server
# FHIR_SERVER=http://your-fhir-server.com

# File directories
# FILES_DIR=/app/webroot/files
# DOWNLOADS_DIR=/app/webroot/files/downloads

# External database (if needed)
# EXTERNAL_DB_URL=

# SMTP configuration
# SMTP_HOST=smtp.washington.edu
# SMTP_PORT=587
# SMTP_TLS=1
# SMTP_SSL=0
# SMTP_USER=vte-validation@cirg.washington.edu
# SMTP_PASSWORD=your_smtp_password_here
# EMAIL_ATTACH_PACKET=0
# EMAIL_TEST_MODE=0
