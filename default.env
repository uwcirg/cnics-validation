# Default environment file; copy to .env and modify as necessary

###
### Docker Compose environment variables
###
# `docker compose` must be run from the same directory as this file
# (or pointed at it via --project-directory / --env-file).
# https://docs.docker.com/compose/how-tos/environment-variables/variable-interpolation/
# Variables here are interpolated into docker-compose.yaml.

# Project name — namespaces containers, networks, and named volumes.
# Defaults to the directory name if unset. Override to run multiple
# deploys of this stack on the same host without collisions.
# COMPOSE_PROJECT_NAME=cnics-validation

# Container port to expose to internet
# EXTERNAL_PORT=

# Enable to use docker deployment development overrides
# COMPOSE_FILE=docker-compose.yaml:docker-compose.dev.yaml

# Fully qualified domain name
# Used to configure vite.config allowedHosts; configure traefik deploys;
# SERVER_NAME=foo.cirg.uw.edu

###
### Default environment variables for mci container
### Variables with VITE_ prefix will be available to the frontend client
###

# FHIR_SERVER: not currently used — retained for backward compatibility;
# no runtime component reads this value.
#FHIR_SERVER=http://example-fhir-server.com

# Allowed origin for CORS requests to the backend
FRONTEND_ORIGIN=https://frontend.foo.cirg.uw.edu

# Example URL for an additional database
EXTERNAL_DB_URL=

# --- Outbound email configuration ---
# Example SMTP server host and port (replace in your local .env)
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Enable TLS (STARTTLS) or SSL
SMTP_TLS=1
SMTP_SSL=0

# Optional SMTP auth
# NOTE: Do NOT commit real credentials. Put real values in your untracked .env
SMTP_USER=example-user@example.com
SMTP_PASSWORD=CHANGEME

# From/Reply-To and subject prefix
EMAIL_FROM=noreply@example.org
EMAIL_REPLY_TO=support@example.org
EMAIL_HELP_ADDRESS=support@example.org
EMAIL_SUBJECT_PREFIX=Your Project Name

# Attach packet to emails when available (0/1)
EMAIL_ATTACH_PACKET=0

# When 1, do not actually send; just report success in API (useful for dev)
EMAIL_TEST_MODE=0

# Explicit backend origin for download links; defaults to FRONTEND_ORIGIN
# BACKEND_ORIGIN=
