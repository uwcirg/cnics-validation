# Default environment file; copy to .env and modify as necessary

###
### docker-compose environment variables
###
# `docker-compose` must be run in the same directory as this file
# https://docs.docker.com/compose/environment-variables/#the-env-file
# environmental variables for interpolation in docker-compose YAML files

# Container port to expose to internet
# EXTERNAL_PORT=

# Enable to use docker deployment development overrides
# COMPOSE_FILE=docker-compose.yaml:docker-compose.dev.yaml

# Fully qualified domain name
# Used to configure vite.config allowedHosts; configure traefik deploys;
# SERVER_NAME=foo.cirg.uw.edu

###
### Default environment variables for mci container
### Variables with VITE_ prefix will be available to the frontend client
###

# URL to FHIR server used by the application
FHIR_SERVER=http://example-fhir-server.com

# Allowed origin for CORS requests to the backend
FRONTEND_ORIGIN=https://frontend.foo.cirg.uw.edu

# Example URL for an additional database
EXTERNAL_DB_URL=

# --- Outbound email configuration ---
# SMTP server host and port
SMTP_HOST=smtp.washington.edu
SMTP_PORT=587

# Enable TLS (STARTTLS) or SSL
SMTP_TLS=1
SMTP_SSL=0

# Optional SMTP auth
SMTP_USER=cnics-validation@cirg.washington.edu
SMTP_PASSWORD=quah5Shotah4Eng7

# From/Reply-To and subject prefix
EMAIL_FROM=cnics-validation@cirg.washington.edu
EMAIL_REPLY_TO=cnics-validation@cirg.washington.edu
EMAIL_HELP_ADDRESS=cnics-validation@cirg.washington.edu
EMAIL_SUBJECT_PREFIX=CNICS / NA-ACCORD

# Attach packet to emails when available (0/1)
EMAIL_ATTACH_PACKET=0

# When 1, do not actually send; just report success in API (useful for dev)
EMAIL_TEST_MODE=0

# Explicit backend origin for download links; defaults to FRONTEND_ORIGIN
# BACKEND_ORIGIN=
