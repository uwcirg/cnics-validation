# Default environment file; copy to .env and modify as necessary

###
### Docker Compose environment variables
###
# `docker compose` must be run from the same directory as this file
# (or pointed at it via --project-directory / --env-file).
# https://docs.docker.com/compose/how-tos/environment-variables/variable-interpolation/
# Variables here are interpolated into docker-compose.yaml.

# Project name — namespaces containers, networks, and named volumes.
# Defaults to the directory name if unset. Override to run multiple
# deploys of this stack on the same host without collisions.
# COMPOSE_PROJECT_NAME=cnics-validation

# Host port for the `web` service (the React/Vite frontend).
# Defaults to 3000 if unset. Bound to 127.0.0.1 in docker-compose.yaml,
# so reachable only from this host (typically reverse-proxied by Apache).
# Required to be distinct per deployment when running multiple
# deployments of this stack on the same host.
# EXTERNAL_PORT=3000

# Host port for the `backend` service (the Flask API).
# Defaults to 3001 if unset. Bound to 127.0.0.1 in docker-compose.yaml,
# so reachable only from this host (the web service and Apache front-end
# reach it over Docker's internal network and via localhost respectively).
# Required to be distinct per deployment when running multiple
# deployments of this stack on the same host.
# BACKEND_EXTERNAL_PORT=3001

# Enable to use docker deployment development overrides
# COMPOSE_FILE=docker-compose.yaml:docker-compose.dev.yaml

# Fully qualified domain name
# Used by vite.config for allowedHosts, and as the HMR host fallback
# when the dev server is fronted by a reverse proxy / HTTPS domain.
# SERVER_NAME=foo.cirg.uw.edu

###
### Authentication / development overrides
###
# DANGER: Read before changing. The Flask backend's normal first-release
# auth flow is: Apache `.htaccess` performs HTTP Basic Auth + LDAP, and
# on success forwards the authenticated identity to the backend as the
# `X-Remote-User` request header. The constitution
# (`.specify/memory/constitution.md`, Security & Data Governance →
# Authentication) prohibits short-circuiting that chain in study
# deployments.
#
# Setting ALLOW_DEV_HEADER=1 enables a fallback path that lets any
# caller set their identity via an `X-Dev-User: <login>` header and
# also unlocks several admin-only dev endpoints. This is intended for
# local development only and MUST be left at the default (0) in any
# deployment that is reachable from anything other than the developer's
# own machine.
ALLOW_DEV_HEADER=0

###
### Database configuration
###
# Credentials for the bundled MariaDB container; consumed by the mariadb and
# backend services. Replace the placeholder values in your local .env.
DB_ROOT_PASSWORD=CHANGEME_root
DB_NAME=cnics_mci
DB_USER=mci_user
DB_PASSWORD=CHANGEME

###
### Default environment variables for mci container
### Variables with VITE_ prefix will be available to the frontend client
###

# Directory containing instruction/reference files mounted read-only into the
# backend at /files. Defaults to ./app/webroot/files if unset.
# FILES_DIR=./app/webroot/files

# FHIR_SERVER: not currently used — retained for backward compatibility;
# no runtime component reads this value.
#FHIR_SERVER=http://example-fhir-server.com

# Allowed origin for CORS requests to the backend
FRONTEND_ORIGIN=https://frontend.foo.cirg.uw.edu

# --- Bridge to the cnics_data Patient roster ---
# The `patients_view` view in this DB UNIONs the locally-owned `uw_patients2`
# table with a FEDERATED proxy of the upstream `cnics_data.Patient` table
# (see init/06-create-patients-view.sh).
#
# The cnics_data server listens only on the VM host's loopback interface,
# which a bridged container cannot reach over TCP. So the proxy reaches it
# over the host's MariaDB/MySQL Unix socket. CNICS_DATA_SOCKET_DIR is the
# directory on the VM host that holds that socket; docker-compose.yaml
# bind-mounts it into the mariadb container. The socket file inside must
# be named `mysqld.sock`.
CNICS_DATA_SOCKET_DIR=/var/run/mysqld
#
# Identify the upstream schema/table and the bridge user. That user needs
# only SELECT on cnics_data.Patient — keep it read-only. Leaving
# CNICS_DATA_DB_USER empty disables the bridge entirely; patients_view is
# then defined over uw_patients2 alone (single-instance / dev fallback).
CNICS_DATA_DB_NAME=cnics_data
CNICS_DATA_DB_TABLE=Patient
CNICS_DATA_DB_USER=
CNICS_DATA_DB_PASSWORD=

# --- Outbound email configuration ---
# Example SMTP server host and port (replace in your local .env)
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Enable TLS (STARTTLS) or SSL
SMTP_TLS=1
SMTP_SSL=0

# Optional SMTP auth
# NOTE: Do NOT commit real credentials. Put real values in your untracked .env
SMTP_USER=example-user@example.com
SMTP_PASSWORD=CHANGEME

# From/Reply-To and subject prefix
EMAIL_FROM=noreply@example.org
EMAIL_REPLY_TO=support@example.org
EMAIL_HELP_ADDRESS=support@example.org
EMAIL_SUBJECT_PREFIX=Your Project Name

# Attach packet to emails when available (0/1)
EMAIL_ATTACH_PACKET=0

# When 1, do not actually send; just report success in API (useful for dev)
EMAIL_TEST_MODE=0

# Explicit backend origin for download links; defaults to FRONTEND_ORIGIN
# BACKEND_ORIGIN=
