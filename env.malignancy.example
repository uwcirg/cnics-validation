# Malignancy Study Environment Configuration
# This file is commented out until Malignancy study migration is needed
# Uncomment and modify as needed for Malignancy study deployment
# Note: Does not use CakePHP, separate architecture

# Study identification
# STUDY_TYPE=malignancy
# STUDY_NAME="Malignancy Validation"
# STUDY_ABBREVIATION="MALIGNANCY"

# Database configuration
# DB_NAME=cnics_malignancy_validation
# DB_USER=cnics_malignancy_user
# DB_PASSWORD=your_malignancy_password_here

# Domain and CORS configuration
# FRONTEND_ORIGIN=https://malignancy-validation.cirg.uw.edu
# SERVER_NAME=malignancy-validation.cirg.uw.edu

# Study-specific features
# ENABLE_PRE_SCRUB=false
# ARCHITECTURE=novel  # Does not use CakePHP
# ENABLE_MALIGNANCY_SPECIFIC_FIELDS=true

# Email configuration
# EMAIL_SUBJECT_PREFIX=CNICS / Malignancy Validation
# EMAIL_FROM=malignancy-validation@cirg.washington.edu
# EMAIL_REPLY_TO=malignancy-validation@cirg.washington.edu

# FHIR server
# FHIR_SERVER=http://your-fhir-server.com

# File directories
# FILES_DIR=/app/webroot/files
# DOWNLOADS_DIR=/app/webroot/files/downloads

# External database (if needed)
# EXTERNAL_DB_URL=

# SMTP configuration
# SMTP_HOST=smtp.washington.edu
# SMTP_PORT=587
# SMTP_TLS=1
# SMTP_SSL=0
# SMTP_USER=malignancy-validation@cirg.washington.edu
# SMTP_PASSWORD=your_smtp_password_here
# EMAIL_ATTACH_PACKET=0
# EMAIL_TEST_MODE=0
