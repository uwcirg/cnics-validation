# CVA (Cerebrovascular Events - Stroke) Study Environment Configuration
# This file is commented out until CVA study migration is needed
# Uncomment and modify as needed for CVA study deployment

# Study identification
# STUDY_TYPE=cva
# STUDY_NAME="CVA Validation"
# STUDY_ABBREVIATION="CVA"

# Database configuration
# DB_NAME=cnics_cva_validation
# DB_USER=cnics_cva_user
# DB_PASSWORD=your_cva_password_here

# Domain and CORS configuration
# FRONTEND_ORIGIN=https://cva-validation.cirg.uw.edu
# SERVER_NAME=cva-validation.cirg.uw.edu

# Study-specific features
# ENABLE_QUESTIONNAIRES=true  # CVA has questionnaire functionality
# ENABLE_SURVEY_MODULE=true
# ENABLE_CVA_SPECIFIC_FIELDS=true

# Email configuration
# EMAIL_SUBJECT_PREFIX=CNICS / CVA Validation
# EMAIL_FROM=cva-validation@cirg.washington.edu
# EMAIL_REPLY_TO=cva-validation@cirg.washington.edu

# FHIR server
# FHIR_SERVER=http://your-fhir-server.com

# File directories
# FILES_DIR=/app/webroot/files
# DOWNLOADS_DIR=/app/webroot/files/downloads

# External database (if needed)
# EXTERNAL_DB_URL=

# SMTP configuration
# SMTP_HOST=smtp.washington.edu
# SMTP_PORT=587
# SMTP_TLS=1
# SMTP_SSL=0
# SMTP_USER=cva-validation@cirg.washington.edu
# SMTP_PASSWORD=your_smtp_password_here
# EMAIL_ATTACH_PACKET=0
# EMAIL_TEST_MODE=0
