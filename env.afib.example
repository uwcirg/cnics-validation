# AFIB Study Environment Configuration
# This file is commented out until AFIB study migration is needed
# Uncomment and modify as needed for AFIB study deployment
# Note: No immediate plans for use per Heidi

# Study identification
# STUDY_TYPE=afib
# STUDY_NAME="AFIB Validation"
# STUDY_ABBREVIATION="AFIB"

# Database configuration
# DB_NAME=cnics_afib_validation
# DB_USER=cnics_afib_user
# DB_PASSWORD=your_afib_password_here

# Domain and CORS configuration
# FRONTEND_ORIGIN=https://afib-validation.cirg.uw.edu
# SERVER_NAME=afib-validation.cirg.uw.edu

# Study-specific features
# ENABLE_PRE_SCRUB=false
# STATUS=inactive  # No immediate plans per Heidi
# ENABLE_AFIB_SPECIFIC_FIELDS=true

# Email configuration
# EMAIL_SUBJECT_PREFIX=CNICS / AFIB Validation
# EMAIL_FROM=afib-validation@cirg.washington.edu
# EMAIL_REPLY_TO=afib-validation@cirg.washington.edu

# FHIR server
# FHIR_SERVER=http://your-fhir-server.com

# File directories
# FILES_DIR=/app/webroot/files
# DOWNLOADS_DIR=/app/webroot/files/downloads

# External database (if needed)
# EXTERNAL_DB_URL=

# SMTP configuration
# SMTP_HOST=smtp.washington.edu
# SMTP_PORT=587
# SMTP_TLS=1
# SMTP_SSL=0
# SMTP_USER=afib-validation@cirg.washington.edu
# SMTP_PASSWORD=your_smtp_password_here
# EMAIL_ATTACH_PACKET=0
# EMAIL_TEST_MODE=0
