# Environment configuration for frontend client application

# Base URL for the backend API used by the React frontend
# Leave empty to use same-origin (recommended for unified domain deployments)
VITE_API_URL=

# Debug option for NON-PROD deployments serving `vite build` output
# Variable inspection works best in Chrome dev tools
# DEBUG=1

# Where the Vite dev server forwards /api requests. Defaults to the `backend`
# service on the internal Compose network; override for a non-containerized
# local deployment (e.g. http://localhost:3001).
# VITE_API_PROXY_TARGET=http://backend:3000

# How long that proxy waits on a request before giving up, in milliseconds.
# Bulk CSV imports cost one federated patient lookup per row and can run past a
# minute, so the default is deliberately generous.
# VITE_API_PROXY_TIMEOUT_MS=600000
